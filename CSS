* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: #0d0d0d;
    color: #e0e0e0;
    line-height: 1.6;
}

/* NAVBAR */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background-color: rgba(13, 13, 13, 0.95);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid #222;
}

.nav-brand {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem;
    font-weight: 900;
    color: #e50914;
    letter-spacing: 2px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
}

.nav-links a {
    color: #888;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    font-weight: 600;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #fff;
}

/* BUTTONS */
.btn-primary-sm, .btn-primary, .btn-submit {
    background-color: #e50914;
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    transition: 0.3s;
    display: inline-block;
    text-align: center;
}

.btn-primary-sm:hover, .btn-primary:hover, .btn-submit:hover {
    background-color: #b20710;
    box-shadow: 0 0 15px rgba(229, 9, 20, 0.5);
}

.btn-outline {
    background: transparent;
    color: #fff;
    border: 1px solid #e50914;
    padding: 12px 25px;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}

.btn-outline:hover {
    background-color: #e50914;
}

.btn-text {
    color: #888;
    text-decoration: underline;
    margin-left: 15px;
    font-size: 0.9rem;
}

/* HERO SECTION */
.hero-section {
    padding: 140px 8% 60px;
    text-align: center;
    border-bottom: 1px solid #1a1a1a;
}

.badge-tag {
    color: #e50914;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.glitch-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 4rem;
    font-weight: 900;
    letter-spacing: 4px;
    margin: 10px 0;
    color: #fff;
}

.hero-subtitle {
    color: #aaa;
    font-size: 1rem;
    margin-bottom: 40px;
}

.hero-quote-box {
    background-color: #121212;
    border: 1px solid #222;
    padding: 40px 20px;
    max-width: 800px;
    margin: 0 auto;
}

.hero-quote-box h2 {
    font-size: 2rem;
    letter-spacing: 2px;
}

.highlight-text {
    color: #e50914;
    font-weight: 700;
    margin-bottom: 20px;
}

.bold-quote {
    font-weight: 800;
    color: #fff;
    margin-top: 15px;
}

.sub-quote {
    font-style: italic;
    color: #777;
    font-size: 0.9rem;
}

/* COUNTDOWN SECTION */
.countdown-section {
    padding: 60px 8%;
    text-align: center;
    background-color: #111;
    border-bottom: 1px solid #1a1a1a;
}

.timer-container {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 30px 0;
}

.time-box {
    background-color: #181818;
    border: 1px solid #333;
    padding: 20px;
    min-width: 90px;
}

.time-box span {
    font-size: 2.5rem;
    font-weight: 900;
    color: #fff;
    display: block;
}

.time-box p {
    font-size: 0.7rem;
    color: #666;
    letter-spacing: 1px;
}

/* PRODUCT SECTION */
.product-section {
    padding: 80px 8%;
    border-bottom: 1px solid #1a1a1a;
}

.product-card {
    display: flex;
    gap: 50px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
}

.product-image-box {
    flex: 1;
    background-color: #151515;
    border: 1px solid #222;
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}

.image-placeholder {
    text-align: center;
    color: #e50914;
}

.image-placeholder h2 {
    font-size: 3rem;
    font-weight: 900;
}

.product-details {
    flex: 1;
}

.product-details h2 {
    font-size: 2rem;
    margin: 10px 0;
}

.product-desc {
    color: #999;
    font-size: 0.9rem;
    margin-bottom: 20px;
}

.product-specs {
    font-size: 0.85rem;
    color: #aaa;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.product-specs span {
    color: #fff;
    font-weight: 700;
}

.price-tag {
    font-size: 1.5rem;
    font-weight: 800;
    color: #e50914;
    margin-bottom: 25px;
}

/* GRID FEATURES */
.features-section, .size-section, .story-section, .faq-section {
    padding: 80px 8%;
    border-bottom: 1px solid #1a1a1a;
}

.section-title {
    text-align: center;
    font-size: 1.8rem;
    letter-spacing: 2px;
    margin-bottom: 40px;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.feature-card {
    background-color: #121212;
    border: 1px solid #222;
    padding: 30px;
    position: relative;
}

.feature-card .num {
    font-size: 2rem;
    font-weight: 900;
    color: #222;
    position: absolute;
    top: 15px;
    right: 20px;
}

.feature-card h3 {
    font-size: 1.1rem;
    margin-bottom: 10px;
}

.feature-card p {
    color: #777;
    font-size: 0.85rem;
}

/* TABLE SIZE CHART */
.table-responsive {
    overflow-x: auto;
}

table {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    border-collapse: collapse;
    text-align: center;
}

th, td {
    padding: 15px;
    border: 1px solid #222;
}

th {
    background-color: #151515;
    color: #e50914;
    font-size: 0.85rem;
}

td {
    background-color: #101010;
    font-size: 0.9rem;
}

/* FORM SECTION */
.form-section {
    padding: 80px 8%;
    background-color: #0f0f0f;
    border-bottom: 1px solid #1a1a1a;
}

.form-container {
    max-width: 650px;
    margin: 0 auto;
    background-color: #141414;
    border: 1px solid #222;
    padding: 40px;
}

.form-container h2 {
    text-align: center;
    font-size: 1.8rem;
}

.form-sub {
    text-align: center;
    color: #777;
    font-size: 0.85rem;
    margin-bottom: 30px;
}

.form-group-row {
    display: flex;
    gap: 20px;
}

.form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

.form-group label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #aaa;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.form-group input, .form-group select, .form-group textarea {
    background-color: #0a0a0a;
    border: 1px solid #333;
    padding: 12px;
    color: #fff;
    outline: none;
}

.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: #e50914;
}

.btn-submit {
    width: 100%;
    padding: 15px;
    margin-top: 10px;
}

.success-box {
    text-align: center;
    padding: 20px;
}

.success-box h3 {
    color: #e50914;
    font-size: 1.5rem;
    margin-bottom: 10px;
}

.hidden {
    display: none;
}

/* FAQ */
.faq-accordion {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.faq-item {
    background-color: #121212;
    border: 1px solid #222;
    padding: 15px 20px;
    cursor: pointer;
}

.faq-item summary {
    font-weight: 700;
    font-size: 0.9rem;
    color: #eee;
    outline: none;
}

.faq-item p {
    margin-top: 15px;
    color: #888;
    font-size: 0.85rem;
}

/* FOOTER */
.footer {
    padding: 60px 8%;
    text-align: center;
    background-color: #080808;
}

.footer-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.footer-brand {
    color: #e50914;
    font-weight: 700;
    margin-bottom: 20px;
}

.footer p {
    color: #444;
    font-size: 0.75rem;
}

/* RESPONSIVE DESIGN */
@media (max-width: 768px) {
    .navbar {
        flex-direction: column;
        gap: 15px;
    }
    .product-card {
        flex-direction: column;
    }
    .form-group-row {
        flex-direction: column;
        gap: 0;
    }
    .glitch-title {
        font-size: 2.8rem;
    }
}
